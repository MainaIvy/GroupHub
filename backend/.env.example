# Copy this file to .env (never commit .env - it is in .gitignore)
# Then run: python manage.py check

SECRET_KEY=change-me-to-a-long-random-secret-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon PostgreSQL connection string (or leave unset to use local sqlite for dev)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Comma-separated list of frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Comma-separated list of origins trusted for CSRF cookies
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Redis for Channels channel layer (leave empty to use in-memory layer)
REDIS_URL=
